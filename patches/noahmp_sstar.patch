 ! Call to Noah-MP driver same as surface_driver
 !------------------------------------------------------------------------
 
+!------------------------------------------------------------------------
+! [noah/ s*] Prescribe soil moisture (PRESCRIBE_SOIL_MOISTURE = 1), just before the physics of this step:
+!   layer 1 <- SMSURF (e.g. SMAP L4 surface), layers 2..NSOIL <- SMROOT (e.g. SMAP L4 root zone).
+!   Total water is replaced; the existing ice is kept (capped at the new total); liquid = total - ice.
+!   Values outside [0, 1] (missing) leave that layer unchanged. Land points only.
+!   The model's own water update during the step is overwritten at the next step.
+!------------------------------------------------------------------------
+         if ( NoahmpIO%PRESCRIBE_SM_OPT == 1 ) then
+            do J = NoahmpIO%YSTART, NoahmpIO%YEND
+               do I = NoahmpIO%XSTART, NoahmpIO%XEND
+                  if ( (NoahmpIO%IVGTYP(I,J) /= NoahmpIO%ISWATER) .and. (NoahmpIO%IVGTYP(I,J) /= NoahmpIO%ISICE) ) then
+                     do K = 1, NoahmpIO%NSOIL
+                        if ( K == 1 ) then
+                           SM_PRESC = NoahmpIO%SMSURF_PRESC(I,J)
+                        else
+                           SM_PRESC = NoahmpIO%SMROOT_PRESC(I,J)
+                        endif
+                        if ( (SM_PRESC >= 0.0) .and. (SM_PRESC <= 1.0) ) then
+                           SM_ICE = max(0.0, NoahmpIO%SMOIS(I,K,J) - NoahmpIO%SH2O(I,K,J))
+                           SM_ICE = min(SM_ICE, SM_PRESC)
+                           NoahmpIO%SMOIS(I,K,J) = SM_PRESC
+                           NoahmpIO%SH2O (I,K,J) = SM_PRESC - SM_ICE
+                        endif
+                     enddo
+                  endif
+               enddo
+            enddo
+         endif
+
          NoahmpIO%sflx_count_sum = 0      ! Timing
          NoahmpIO%ITIMESTEP      = ITIME  ! update time step counter
 
@@ -1038,6 +1070,7 @@
 
          call system_clock(count=NoahmpIO%count_after_sflx, count_rate=NoahmpIO%clock_rate)
          NoahmpIO%sflx_count_sum = NoahmpIO%sflx_count_sum + ( NoahmpIO%count_after_sflx - NoahmpIO%count_before_sflx )
+         NoahmpIO%sflx_count_total = NoahmpIO%sflx_count_total + ( NoahmpIO%count_after_sflx - NoahmpIO%count_before_sflx )  ! [noah/ s*]
 
